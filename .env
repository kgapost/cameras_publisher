# Docker Compose loads this file into the cameras-publisher container.
# All SWARMER modules and PX4 UXRCE_DDS_DOM_ID must use the same ROS domain.
ROS_DOMAIN_ID=42

# Belly-only: belly=1, stereo=0. Stereo-only: belly=0, stereo=1.
# Enable both to publish all three cameras.
CP_BELLY_CAMERA_ENABLED=1
CP_STEREO_CAMERA_ENABLED=0
CP_BELLY_CAMERA_BACKEND=v4l2
CP_STEREO_CAMERA_BACKEND=gstreamer
CP_USE_COMPRESSED_IMAGE_TOPICS=1

# ROS 2 capture services: auto selects stereo when enabled, otherwise belly.
# Set belly or stereo explicitly when both streams are enabled.
CP_CAPTURE_API_MODE=auto
CP_CAPTURE_API_NAMESPACE=/camera/capture
CP_CAPTURE_DIRECTORY=/workspace/captures
CP_CAPTURE_JPEG_QUALITY=90
CP_CAPTURE_VIDEO_FPS=25

# HTTP API alongside ROS: Swagger /docs, OpenAPI schema /openapi.json.
CP_HTTP_API_ENABLED=1
CP_HTTP_API_HOST=0.0.0.0
CP_HTTP_API_PORT=8000
CP_HTTP_API_TIMEOUT=10

# Dual-instance deployment: docker compose -f docker-compose.dual.yml up -d --build
# These settings keep belly/stereo APIs distinct on the same host and ROS domain.
CP_BELLY_HTTP_API_PORT=8000
CP_STEREO_HTTP_API_PORT=8001
CP_BELLY_CAPTURE_API_NAMESPACE=/camera/belly/capture
CP_STEREO_CAPTURE_API_NAMESPACE=/camera/stereo/capture

# Optional calibration/exposure overrides (uncomment to set).
# CP_BELLY_CAMERA_FX=552.0
# CP_BELLY_CAMERA_FY=552.0
# CP_BELLY_CAMERA_CX=320.0
# CP_BELLY_CAMERA_CY=200.0
# CP_BELLY_CAMERA_EXPOSURE=30
# Any other config.py setting NAME can be added here as CP_<NAME>.
